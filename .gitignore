## ── Environment / secrets ──────────────────────────
.env
.env.local
.env.*.local
*/.env
!*/.env.example

## ── OS / editor ─────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

## ── Node (frontend, and backend if Node/Express) ────
node_modules/
frontend/node_modules/
backend/node_modules/
*/dist/
*/build/
*/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

## ── Java / Spring Boot (backend, if Java) ───────────
backend/target/
backend/.mvn/
backend/mvnw
backend/mvnw.cmd
*.class
*.jar
!*/gradle-wrapper.jar
backend/.gradle/
backend/build/
HELP.md

## ── Python (ai-service) ──────────────────────────────
ai-service/__pycache__/
ai-service/**/__pycache__/
ai-service/.venv/
ai-service/venv/
ai-service/*.egg-info/
ai-service/.pytest_cache/
*.pyc

## ── ML model artifacts (usually too large / regenerable) ─
ai-service/models/*.pkl
ai-service/models/*.joblib
ai-service/*.h5

## ── Database ──────────────────────────────────────────
*.sqlite3
*.db

## ── Logs ───────────────────────────────────────────────
*.log
logs/
